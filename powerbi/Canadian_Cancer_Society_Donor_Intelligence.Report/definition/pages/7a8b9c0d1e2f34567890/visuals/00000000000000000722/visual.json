            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Major limitations:",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "Cross-sectional survey outputs: associations are descriptive and do not establish causality.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "Pre-aggregated tables should not be cross-filtered unless a validated lookup dimension connects them.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "No bootstrap confidence intervals are displayed in this report layer.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "Channel tables describe charitable giving channels overall and may not identify the channel for the Health-category gift.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  },
                  {
                    "value": "The exploratory model is for portfolio demonstration and requires validation before operational use.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12px",
                      "color": "#24313A"
                    }
                  }
                ],
